# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example
kaggle.json
*.pem

# IDE and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Raw/intermediate data: commit only documentation, placeholders, and manifests
data/*
!data/README.md
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/splits/
!data/splits/**
!data/manifests/
!data/manifests/**

# Model artifacts and experiment trackers
*.pt
*.pth
*.ckpt
*.onnx
*.engine
/checkpoints/
/results/checkpoints/*
!/results/checkpoints/.gitkeep
runs/
wandb/
mlruns/
artifacts/

# Generated reports and profiling output
reports/figures/generated/
reports/tables/generated/
profiling/

# Local tools and temporary files
.tools/
tmp/
temp/
*.tmp
*.log
